        {
          "name": "Create vehicle - POST /api/vehicles/",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let jsonData = {};",
                  "try { jsonData = pm.response.json(); } catch (e) {}",
                  "if (jsonData.id) pm.collectionVariables.set('vehicleId', jsonData.id);",
                  "pm.test('Se creó vehicle', function () { pm.expect(jsonData.id).to.exist; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
